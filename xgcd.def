Bootstrap: docker
From: pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime

# ---------------------------------------------------------------------------
# xGCD training container (Stage-1 CBL + Stage-2 xGCD).
#
# Build (pick one):
#   singularity build --fakeroot xgcd.simg xgcd.def      # rootless, on the cluster
#   sudo singularity build xgcd.simg xgcd.def            # if you have root
#   apptainer  build --fakeroot xgcd.simg xgcd.def       # Apptainer equivalent
#
# Run (‑‑nv exposes the host GPUs):
#   singularity exec --nv xgcd.simg python -m methods.contrastive_training.xgcd --help
#   singularity exec --nv --bind /data:/data xgcd.simg python -m methods.contrastive_training.xgcd ...
#
# NOTE: match the CUDA tag (cuda12.1) to your cluster's driver. If nvidia-smi on
# the node shows an older driver, switch the From: line to a *-cuda11.8-* image.
# ---------------------------------------------------------------------------

%files
    requirements.txt /opt/requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        git wget ca-certificates build-essential \
        libgl1 libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip

    # project dependencies (torch/torchvision already provided by the base image)
    python -m pip install --no-cache-dir -r /opt/requirements.txt

    # imported by the code but absent from requirements.txt
    python -m pip install --no-cache-dir wandb

    # Grounding DINO itself (the repo, not just its pure-Python deps in requirements.txt)
    # is NOT installed here for now -- being set up separately. Its deps are still in
    # requirements.txt so that step is a drop-in addition later (git clone + `pip install
    # -e <path>`) without needing to touch this file again.

    python -m pip check || true

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    # default entrypoint: `singularity run xgcd.simg <args>` -> python <args>
    exec python "$@"

%test
    python -c "import torch, timm, sklearn, scipy, pandas, loguru, wandb, kmeans_pytorch; \
print('torch', torch.__version__, 'cuda build', torch.version.cuda)"
    python -c "import transformers, fairscale, huggingface_hub, tokenizers; \
print('transformers', transformers.__version__, 'fairscale', fairscale.__version__)"

%labels
    Application xGCD
    Description Stage-1 CBL + Stage-2 xGCD training environment
    PyTorch 2.2.2-cuda12.1-cudnn8

%help
    Singularity image for the xGCD project. GPU access requires the --nv flag.
    Bind your dataset / experiment dirs with --bind. Example:
      singularity exec --nv --bind /scratch/data:/data xgcd.simg \
        python -m methods.contrastive_training.xgcd --dataset_name cifar10 \
        --cbl_dir exp/stage1_cbl_cifar10 --freeze_backbone True --phase1_lambda 0.1
